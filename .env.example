# Exemple d'environnement pour Docker Compose
# Copier ce fichier en `.env` et ajuster les valeurs si besoin.

# Django
QWEN_SECRET_KEY=change-me-in-prod
QWEN_DEBUG=false
QWEN_ALLOWED_HOSTS=*
QWEN_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://0.0.0.0:8000

# Modèle Qwen3-ASR
QWEN_ASR_MODEL=Qwen/Qwen3-ASR-0.6B
QWEN_FORCED_ALIGNER=Qwen/Qwen3-ForcedAligner-0.6B
# Device CPU/GPU (Docker CPU : cpu ; GPU host : cuda:0)
QWEN_DEVICE=cpu
QWEN_DTYPE=bfloat16
QWEN_BACKEND=transformers
QWEN_MAX_NEW_TOKENS=512
QWEN_MAX_CONTEXT_LEN=500

# Redis/Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Cache HuggingFace (monté dans le volume hf_cache)
HF_HOME=/app/.cache/huggingface
TRANSFORMERS_CACHE=/app/.cache/huggingface
XDG_CACHE_HOME=/app/.cache

# RGPD
QWEN_RGPD_RETENTION_MONTHS=6
QWEN_RGPD_AUTO_PURGE=1
QWEN_RGPD_PURGE_INTERVAL_SEC=21600

# Application
QWEN_APP_TITLE=Qwen3-ASR Web